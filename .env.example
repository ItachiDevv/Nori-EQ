# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — model overrides (defaults shown)
GEMINI_AUDIO_MODEL=gemini-2.5-pro
GEMINI_AUDIO_FALLBACK=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional — override the bundled ffmpeg binary path
# FFMPEG_BIN=/usr/local/bin/ffmpeg

# Optional — Express dev server port (default 3000)
# PORT=3000
